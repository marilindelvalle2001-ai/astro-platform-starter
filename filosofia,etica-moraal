  <style>
    :root{
      --bg:#0f1724; /* dark navy */
      --card:#0b1220;
      --muted:#9aa4b2;
      --accent:#6ee7b7; /* soft green */
      --glass: rgba(255,255,255,0.04);
      --maxw:1000px;
      --radius:14px;
      color-scheme: dark;
    }
    *{box-sizing:border-box}
    html,body{height:100%;margin:0;font-family:Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background:linear-gradient(180deg,#071022 0%, #051021 60%); color:#e6eef6}
    a{color:var(--accent); text-decoration:none}
    .container{max-width:var(--maxw);margin:28px auto;padding:24px}
    header{display:flex;align-items:center;gap:18px}
    .brand{display:flex;align-items:center;gap:12px}
    .logo{width:56px;height:56px;border-radius:12px;background:linear-gradient(135deg,#0ea5a9,#7c3aed);display:flex;align-items:center;justify-content:center;font-weight:700;color:#051021}
    h1{font-size:1.6rem;margin:0}
    p.lead{margin:6px 0 0;color:var(--muted)}
    nav{margin-top:18px;display:flex;gap:8px;flex-wrap:wrap}
    .navbtn{background:var(--glass);border:1px solid rgba(255,255,255,0.03);padding:8px 12px;border-radius:10px;cursor:pointer}
    .navbtn.active{background:linear-gradient(90deg, rgba(110,231,183,0.08), rgba(124,58,237,0.04));border:1px solid rgba(110,231,183,0.12)}
    main{margin-top:22px;display:grid;grid-template-columns:1fr 320px;gap:22px}
    .card{background:linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0.01));padding:18px;border-radius:var(--radius);box-shadow:0 6px 20px rgba(2,6,23,0.6);border:1px solid rgba(255,255,255,0.03)}
    .content h2{margin-top:0}
    .toc{position:sticky;top:28px}
    .small{color:var(--muted);font-size:0.95rem}
    blockquote{border-left:3px solid rgba(110,231,183,0.18);padding-left:12px;color:var(--muted);margin:12px 0;font-style:italic}
    .tag{display:inline-block;padding:6px 10px;border-radius:999px;background:rgba(255,255,255,0.02);border:1px solid rgba(255,255,255,0.02);font-size:0.85rem}
    footer{margin-top:28px;text-align:center;color:var(--muted);font-size:0.9rem}
    .compare{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    pre{background:#031022;padding:12px;border-radius:8px;overflow:auto}
    /* responsive */
    @media (max-width:900px){main{grid-template-columns:1fr} .toc{position:relative;top:auto}}
    /* simple hero */
    .hero{display:flex;gap:18px;align-items:center;padding:18px;border-radius:12px;background:linear-gradient(90deg, rgba(7,18,34,0.6), rgba(5,16,33,0.4));border:1px solid rgba(255,255,255,0.02)}
    .btn-primary{background:linear-gradient(90deg,#10b981,#7c3aed);padding:10px 14px;border-radius:10px;color:#021426;border:none;cursor:pointer}
    .muted{color:var(--muted)}
    .quote-author{display:block;margin-top:8px;color:var(--muted);font-weight:600}
    .contact-form input, .contact-form textarea{width:100%;padding:10px;border-radius:8px;border:1px solid rgba(255,255,255,0.04);background:transparent;color:inherit;margin-top:8px}
    .contact-form button{margin-top:10px}
    .footer-links{display:flex;gap:12px;justify-content:center;margin-top:8px}
    .accent-underline{background:linear-gradient(90deg,#6ee7b7,#7c3aed);-webkit-background-clip:text;background-clip:text;color:transparent}
    /* small utility */
    .muted-block{background:rgba(255,255,255,0.02);padding:12px;border-radius:10px;border:1px solid rgba(255,255,255,0.02)}
